# Copia a .env. Los valores de ejemplo son solo para desarrollo local.
DJANGO_SECRET_KEY=dev-only-change-before-deploying
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Administrador inicial: se crea solo si el usuario aún no existe.
# Configura nombre y contraseña antes del primer arranque del backend.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

AI_PROVIDER=gemini
AI_API_KEY=

POSTGRES_DB=eafinder
POSTGRES_USER=eafinder
POSTGRES_PASSWORD=dev-only-change-before-deploying

# Usado por el perfil HTTPS de producción (docker compose --profile production up).
DOMAIN=localhost
