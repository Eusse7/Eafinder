# Copia este archivo a backend/.env y completa los valores.
# backend/.env NO se sube al repositorio.

AI_PROVIDER=gemini
AI_API_KEY=

# Opcional: solo si se quiere cambiar los modelos por defecto.
# AI_CHAT_MODEL=gemini-3.6-flash
# AI_EMBEDDING_MODEL=gemini-embedding-001

# Tope de tokens de la respuesta. En los modelos Gemini 3.x el razonamiento
# interno se descuenta de aquí: si las respuestas llegan vacías, súbelo.
AI_MAX_OUTPUT_TOKENS=2048

# Cuánto razona el modelo antes de responder: minimal, low, medium o high.
AI_THINKING_LEVEL=low

# Fragmentos por llamada al calcular embeddings.
AI_EMBED_BATCH_SIZE=10

# --- Pipeline RAG ----------------------------------------------------------
# Cuántos artículos se le pasan al modelo como contexto.
RAG_TOP_K=4
# Similitud mínima para responder. Si ningún artículo la supera, EAFinder
# dice que no tiene información en vez de inventar.
RAG_MIN_RELEVANCE=0.55

# --- Django ----------------------------------------------------------------
DJANGO_DEBUG=True
# CORS_ALLOWED_ORIGINS=http://localhost:4200
