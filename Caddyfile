    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /gestion/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle /static/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
